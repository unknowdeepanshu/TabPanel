{
  "manifest_version": 3,
  "name": "TabPlan",
  "version": "1.0.0",
  "description": "Manage and organize browser tabs by project",

  "icons": {
    "16": "icons/icons.svg"
  },

  "action": {
    "default_popup": "index.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"]
    }
  ],

  "commands": {
    "toggle-tabplan": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Open or close TabPlan"
    }
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "permissions": ["activeTab", "scripting"]
}
